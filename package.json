{
  "name": "my-2d-game",
  "version": "0.1.0",
  "description": "2D game built on a custom modular engine (Phaser 3 core)",
  "scripts": {
    "dev": "npx http-server . -p 8080 -c-1",
    "cap:init": "npx cap init \"My Game\" \"com.example.mygame\" --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "http-server": "^14.1.1"
  }
}
